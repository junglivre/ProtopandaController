<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Status bar: single row showing the current overall state
         (Connected / Advertising / Waiting for connection / etc). -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="@color/bg_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/dot_idle"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Initialising…"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/open_settings"
            android:text=""
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/close_app"
            android:text=""
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROTOPANDA"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        All controls (D-pad + L1/R1) live in one ConstraintLayout so L1/R1 can
        be constrained directly against btnBack's own top/bottom — that's what
        pins their vertical position to "the height of the Back button" instead
        of the very bottom of the screen, keeping them clear of the phone's
        gesture/nav bar.

        D-pad layout:
              [btnUp    = index 3]
        [btnLeft=2][btnOk=4][btnRight=0]
              [btnDown  = index 1]
              [btnBack  = index 5]
        [btnL1 = index 6]      [btnR1 = index 7]  (same Y band as btnBack)
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/tvImu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- OK: center anchor at 30% vertical -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOk"
            style="@style/PawButton"
            android:text="OK"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.28"
            app:layout_constraintHeight_percent="0.20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.28" />

        <!-- UP: above OK, same horizontal center -->

        <!-- LEFT: left of OK, vertically centered on OK -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUp"
            style="@style/PawButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="12dp"
            android:text="▲"
            app:layout_constraintBottom_toTopOf="@id/btnOk"
            app:layout_constraintEnd_toEndOf="@id/btnOk"
            app:layout_constraintHeight_percent="0.20"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/btnOk"
            app:layout_constraintWidth_percent="0.28" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeft"
            style="@style/PawButton"
            android:text="◀"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.28"
            app:layout_constraintHeight_percent="0.20"
            app:layout_constraintTop_toTopOf="@id/btnOk"
            app:layout_constraintBottom_toBottomOf="@id/btnOk"
            app:layout_constraintEnd_toStartOf="@id/btnOk"
            android:layout_marginEnd="10dp" />

        <!-- RIGHT: right of OK, vertically centered on OK -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRight"
            style="@style/PawButton"
            android:text="▶"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.28"
            app:layout_constraintHeight_percent="0.20"
            app:layout_constraintTop_toTopOf="@id/btnOk"
            app:layout_constraintBottom_toBottomOf="@id/btnOk"
            app:layout_constraintStart_toEndOf="@id/btnOk"
            android:layout_marginStart="10dp" />

        <!-- DOWN: below OK -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDown"
            style="@style/PawButton"
            android:text="▼"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.28"
            app:layout_constraintHeight_percent="0.20"
            app:layout_constraintStart_toStartOf="@id/btnOk"
            app:layout_constraintEnd_toEndOf="@id/btnOk"
            app:layout_constraintTop_toBottomOf="@id/btnOk"
            android:layout_marginTop="10dp" />

        <!-- BACK: below DOWN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/PawButton"
            android:text="BACK"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.28"
            app:layout_constraintHeight_percent="0.20"
            app:layout_constraintStart_toStartOf="@id/btnOk"
            app:layout_constraintEnd_toEndOf="@id/btnOk"
            app:layout_constraintTop_toBottomOf="@id/btnDown"
            android:layout_marginTop="18dp" />

        <!-- L1 / R1: pinned to the container's left/right edges, vertically
             matched to btnBack's own top/bottom (not the screen bottom). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnL1"
            style="@style/PawButton"
            android:text="L1"
            android:textSize="16sp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnR1"
            style="@style/PawButton"
            android:text="R1"
            android:textSize="16sp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- IMU readout, directly below the controls, well clear of the nav bar -->
    <TextView
        android:id="@+id/tvImu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        android:text="Acc  X:—  Y:—  Z:— m/s²\nGyro X:—  Y:—  Z:— °/s"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
